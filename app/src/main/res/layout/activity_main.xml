<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="20dp" android:background="#101014">
 <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:text="MARKET SCANNER" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"
  android:gravity="center" android:padding="12dp"/>
 <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:text="BTCUSDT • 5m" android:textColor="#AAAAAA" android:textSize="16sp" android:gravity="center" android:padding="8dp"/>
 <Button android:id="@+id/scan" android:layout_width="match_parent" android:layout_height="64dp"
  android:text="SCAN" android:textSize="20sp"/>
 <TextView android:id="@+id/result" android:layout_width="match_parent" android:layout_height="0dp"
  android:layout_weight="1" android:text="Scan басыңыз" android:textColor="#FFFFFF" android:textSize="20sp"
  android:gravity="center" android:padding="20dp"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
  android:text="Тек ақпараттық индикатор. Сигнал кепілдік емес."
  android:textColor="#888888" android:gravity="center" android:padding="8dp"/>
</LinearLayout>